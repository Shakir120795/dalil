SUPABASE_URL=
SUPABASE_SERVICE_KEY=
EMBED_URL=https://<user>-<space>.hf.space
EMBED_TOKEN=
MIN_SIM=0.45
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID_MONTHLY=   # Razorpay Dashboard > Subscriptions > Plans: the id (plan_...) of the ₹149/month plan
RAZORPAY_PLAN_ID_YEARLY=    # the id (plan_...) of the ₹999/year plan
RAZORPAY_WEBHOOK_SECRET=    # the webhook secret — used to verify signatures on /api/pay/webhook
DAILY_API_KEY=
ADMIN_EMAILS=you@example.com
LLM_BASE_URL=        # optional, e.g. https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
NEXT_PUBLIC_SITE_URL=https://getdalil.app
# --- Push notifications (Phase 10) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # Web Push (browser) public key — generate: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=              # its private half (server only, never expose)
VAPID_SUBJECT=mailto:admin@getdalil.app   # contact the push services can reach you at
FIREBASE_SERVICE_ACCOUNT=       # Firebase service-account JSON (one line) — used to send FCM pushes to the Android app
CRON_SECRET=                    # secret for POST /api/push/daily (Authorization: Bearer <secret>)
